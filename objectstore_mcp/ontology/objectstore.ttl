@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix : <https://knuckles-team.github.io/ontology/connector/objectstore#> .
@prefix core: <https://knuckles-team.github.io/ontology/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Object-storage ontology — named stores, buckets/containers, and the objects they
# hold, across S3/MinIO/R2, Google Cloud Storage, Azure Blob, and a local filesystem
# backend. All classes and properties live in the shared `:` (kg#) namespace; only the
# owl:Ontology node gets the per-package IRI. Backs the objectstore-mcp tool surface
# (one typed tool per operation) and its native ingestion (objectstore_ingest_buckets, objectstore_ingest_objects).
#
# NOTE: object storage IS a blob backend. This model captures typed :Object *metadata*
# (key, size, etag, content-type, storage-class) — it deliberately does NOT copy object
# bytes into the KG. Where an object's raw bytes are separately ingested as a shared
# :Blob, link it with :hasBlob rather than duplicating the payload.

:ObjectStore a owl:Class ;
    rdfs:label "Object Store" ;
    rdfs:comment "A configured named store: one backend (s3/gcs/azure/webdav/filesystem) plus its endpoint/region/root (objectstore_list_stores)." ;
    rdfs:subClassOf core:StorageContainer, core:Database .

:Bucket a owl:Class ;
    rdfs:label "Bucket" ;
    rdfs:comment "A bucket or container that holds objects within an ObjectStore (objectstore_list_buckets, objectstore_bucket_info)." ;
    rdfs:subClassOf core:StorageContainer, core:Collection .

:Object a owl:Class ;
    rdfs:label "Object" ;
    rdfs:comment "A stored object described by its key + metadata (objectstore_list_objects, objectstore_head_object). Metadata only — the raw bytes are NOT copied into the graph." ;
    rdfs:subClassOf core:File, core:Blob .

# --- links (owl:ObjectProperty) ---

:inStore a owl:ObjectProperty ;
    rdfs:label "in store" ;
    rdfs:subPropertyOf core:partOf ;
    rdfs:comment "Links a Bucket to the ObjectStore that hosts it." ;
    rdfs:domain :Bucket ;
    rdfs:range :ObjectStore .

:inBucket a owl:ObjectProperty ;
    rdfs:label "in bucket" ;
    rdfs:subPropertyOf core:partOf ;
    rdfs:comment "Links an Object to the Bucket that contains it." ;
    rdfs:domain :Object ;
    rdfs:range :Bucket .

:hasBlob a owl:ObjectProperty ;
    rdfs:label "has blob" ;
    rdfs:comment "Links an Object to the shared :Blob holding its raw bytes, when those bytes were separately content-addressed into the graph (avoids double-storing the payload)." ;
    rdfs:domain :Object ;
    rdfs:range core:Blob .

:ownedBy a owl:ObjectProperty ;
    rdfs:label "owned by" ;
    rdfs:comment "Links a Bucket or Object to the Person/Agent responsible for it." ;
    rdfs:range core:Person .

# --- fields (owl:DatatypeProperty) ---

:backendType a owl:DatatypeProperty ;
    rdfs:label "backend type" ;
    rdfs:comment "Storage backend of an ObjectStore (s3, gcs, azure, filesystem)." ;
    rdfs:domain :ObjectStore ;
    rdfs:range xsd:string .

:endpoint a owl:DatatypeProperty ;
    rdfs:label "endpoint" ;
    rdfs:comment "Service endpoint URL of an ObjectStore (e.g. a MinIO/R2 endpoint)." ;
    rdfs:domain :ObjectStore ;
    rdfs:range xsd:string .

:location a owl:DatatypeProperty ;
    rdfs:label "location" ;
    rdfs:comment "Region/location of a Bucket or ObjectStore (e.g. us-east-1)." ;
    rdfs:range xsd:string .

:objectKey a owl:DatatypeProperty ;
    rdfs:label "object key" ;
    rdfs:comment "The full key/path of an Object within its bucket." ;
    rdfs:domain :Object ;
    rdfs:range xsd:string .

:byteSize a owl:DatatypeProperty ;
    rdfs:label "byte size" ;
    rdfs:comment "Size of an Object's payload in bytes." ;
    rdfs:domain :Object ;
    rdfs:range xsd:integer .

:etag a owl:DatatypeProperty ;
    rdfs:label "etag" ;
    rdfs:comment "Entity tag / content hash of an Object as reported by the backend." ;
    rdfs:domain :Object ;
    rdfs:range xsd:string .

:contentType a owl:DatatypeProperty ;
    rdfs:label "content type" ;
    rdfs:comment "MIME type of an Object's payload." ;
    rdfs:domain :Object ;
    rdfs:range xsd:string .

:storageClass a owl:DatatypeProperty ;
    rdfs:label "storage class" ;
    rdfs:comment "Provider storage tier of an Object (e.g. STANDARD, GLACIER, COOL)." ;
    rdfs:domain :Object ;
    rdfs:range xsd:string .

:lastModified a owl:DatatypeProperty ;
    rdfs:label "last modified" ;
    rdfs:comment "Last-modified timestamp of an Object (ISO-8601, where available)." ;
    rdfs:domain :Object ;
    rdfs:range xsd:string .

<https://knuckles-team.github.io/ontology/connector/objectstore> a owl:Ontology ;
    rdfs:label "Object Storage Ontology" ;
    rdfs:comment """Object-storage model — named stores, buckets/containers, and the
    objects they hold with their size/etag/content-type/storage-class metadata — across
    S3/MinIO/R2, Google Cloud Storage, Azure Blob, and a local filesystem backend,
    federated into the scion-sdk knowledge-graph hub. Captures object METADATA
    only; object bytes stay in the backing store (or a separately-linked :Blob).""" .

# --- served surface: tools, skills, prompt agent, tool-use contracts, data location ---
# Individuals of medulla core classes (:Tool, :Skill, :Prompt, :Agent, :Task, :TaskStep,
# :Dataset); no core import. tests/test_surface_ontology.py keeps it in step with the served tools.

:tool_objectstore_list_stores a core:Tool ;
    rdfs:label "objectstore_list_stores" ;
    rdfs:comment "List the named stores the caller is entitled to, with backend and endpoint." .

:tool_objectstore_move_object a core:Tool ;
    rdfs:label "objectstore_move_object" ;
    rdfs:comment "Move one object: copy it to dst_bucket/dst_key, then delete the source." .

:tool_objectstore_delete_objects_by_prefix a core:Tool ;
    rdfs:label "objectstore_delete_objects_by_prefix" ;
    rdfs:comment "Delete objects under a non-empty prefix (dry run by default, count-capped)." .

:tool_objectstore_upload_file a core:Tool ;
    rdfs:label "objectstore_upload_file" ;
    rdfs:comment "Upload one local file to an object (capped by OBJECTSTORE_MAX_TRANSFER_BYTES)." .

:tool_objectstore_download_file a core:Tool ;
    rdfs:label "objectstore_download_file" ;
    rdfs:comment "Download one object to a local file (capped by OBJECTSTORE_MAX_TRANSFER_BYTES)." .

:tool_objectstore_upload_directory a core:Tool ;
    rdfs:label "objectstore_upload_directory" ;
    rdfs:comment "Upload every file under a local directory to objects under a prefix (capped)." .

:tool_objectstore_download_prefix a core:Tool ;
    rdfs:label "objectstore_download_prefix" ;
    rdfs:comment "Download the objects under a prefix into a local directory (capped)." .

:tool_objectstore_get_bucket_lifecycle a core:Tool ;
    rdfs:label "objectstore_get_bucket_lifecycle" ;
    rdfs:comment "Read a bucket's lifecycle rules (empty list when none are set)." .

:tool_objectstore_put_bucket_lifecycle a core:Tool ;
    rdfs:label "objectstore_put_bucket_lifecycle" ;
    rdfs:comment "Replace a bucket's lifecycle rules (expiry, noncurrent expiry, transitions)." .

:tool_objectstore_delete_bucket_lifecycle a core:Tool ;
    rdfs:label "objectstore_delete_bucket_lifecycle" ;
    rdfs:comment "Remove every lifecycle rule from a bucket." .

:tool_objectstore_get_bucket_versioning a core:Tool ;
    rdfs:label "objectstore_get_bucket_versioning" ;
    rdfs:comment "Read a bucket's versioning state (Enabled, Suspended or unset)." .

:tool_objectstore_put_bucket_versioning a core:Tool ;
    rdfs:label "objectstore_put_bucket_versioning" ;
    rdfs:comment "Enable or suspend object versioning on a bucket." .

:tool_objectstore_get_object_tags a core:Tool ;
    rdfs:label "objectstore_get_object_tags" ;
    rdfs:comment "Read an object's tag set." .

:tool_objectstore_put_object_tags a core:Tool ;
    rdfs:label "objectstore_put_object_tags" ;
    rdfs:comment "Replace an object's tag set (at most 10 tags)." .

:tool_objectstore_delete_object_tags a core:Tool ;
    rdfs:label "objectstore_delete_object_tags" ;
    rdfs:comment "Remove every tag from an object." .

:tool_objectstore_ingest_buckets a core:Tool ;
    rdfs:label "objectstore_ingest_buckets" ;
    rdfs:comment "Mirror the store's buckets into the knowledge graph as :Bucket nodes." .

:tool_objectstore_ingest_objects a core:Tool ;
    rdfs:label "objectstore_ingest_objects" ;
    rdfs:comment "Mirror object metadata under a prefix into the knowledge graph as :Object nodes." .

:tool_objectstore_bucket_exists a core:Tool ;
    rdfs:label "objectstore_bucket_exists" ;
    rdfs:comment "Return True when the bucket exists." .

:tool_objectstore_bucket_info a core:Tool ;
    rdfs:label "objectstore_bucket_info" ;
    rdfs:comment "Describe one bucket. Raises NotFoundError when absent." .

:tool_objectstore_capabilities a core:Tool ;
    rdfs:label "objectstore_capabilities" ;
    rdfs:comment "Advertise optional capabilities." .

:tool_objectstore_copy_object a core:Tool ;
    rdfs:label "objectstore_copy_object" ;
    rdfs:comment "Server-side (where possible) copy of one object." .

:tool_objectstore_create_bucket a core:Tool ;
    rdfs:label "objectstore_create_bucket" ;
    rdfs:comment "Create a bucket. Raises AlreadyExistsError if it exists." .

:tool_objectstore_delete_bucket a core:Tool ;
    rdfs:label "objectstore_delete_bucket" ;
    rdfs:comment "Delete an EMPTY bucket. Raises BucketNotEmptyError otherwise." .

:tool_objectstore_delete_object a core:Tool ;
    rdfs:label "objectstore_delete_object" ;
    rdfs:comment "Delete exactly one object. Raises NotFoundError when absent." .

:tool_objectstore_get_object a core:Tool ;
    rdfs:label "objectstore_get_object" ;
    rdfs:comment "Download an object's bytes. Raises TooLargeError when the" .

:tool_objectstore_get_object_metadata a core:Tool ;
    rdfs:label "objectstore_get_object_metadata" ;
    rdfs:comment "Return the user metadata of one object." .

:tool_objectstore_head_object a core:Tool ;
    rdfs:label "objectstore_head_object" ;
    rdfs:comment "Stat one object without downloading it." .

:tool_objectstore_list_buckets a core:Tool ;
    rdfs:label "objectstore_list_buckets" ;
    rdfs:comment "List all buckets/containers visible to the credentials." .

:tool_objectstore_list_objects a core:Tool ;
    rdfs:label "objectstore_list_objects" ;
    rdfs:comment "List objects under ``prefix``, optionally folding at ``delimiter``." .

:tool_objectstore_presigned_url a core:Tool ;
    rdfs:label "objectstore_presigned_url" ;
    rdfs:comment "Mint a presigned URL. Raises UnsupportedOperationError when the" .

:tool_objectstore_put_object a core:Tool ;
    rdfs:label "objectstore_put_object" ;
    rdfs:comment "Upload bytes to ``bucket/key`` (overwrites)." .

:tool_objectstore_set_object_metadata a core:Tool ;
    rdfs:label "objectstore_set_object_metadata" ;
    rdfs:comment "Replace the user metadata of one object." .

:skill_objectstore_object_operations a core:Skill ;
    rdfs:label "objectstore-object-operations" ;
    core:usesTool :tool_objectstore_list_objects,
        :tool_objectstore_head_object,
        :tool_objectstore_get_object,
        :tool_objectstore_put_object,
        :tool_objectstore_copy_object,
        :tool_objectstore_move_object,
        :tool_objectstore_delete_object,
        :tool_objectstore_delete_objects_by_prefix,
        :tool_objectstore_presigned_url,
        :tool_objectstore_get_object_metadata,
        :tool_objectstore_set_object_metadata,
        :tool_objectstore_get_object_tags,
        :tool_objectstore_put_object_tags,
        :tool_objectstore_delete_object_tags .

:skill_objectstore_bucket_administration a core:Skill ;
    rdfs:label "objectstore-bucket-administration" ;
    core:usesTool :tool_objectstore_list_stores,
        :tool_objectstore_list_buckets,
        :tool_objectstore_create_bucket,
        :tool_objectstore_bucket_exists,
        :tool_objectstore_bucket_info,
        :tool_objectstore_capabilities,
        :tool_objectstore_delete_bucket,
        :tool_objectstore_get_bucket_lifecycle,
        :tool_objectstore_put_bucket_lifecycle,
        :tool_objectstore_delete_bucket_lifecycle,
        :tool_objectstore_get_bucket_versioning,
        :tool_objectstore_put_bucket_versioning .

:skill_objectstore_data_transfer a core:Skill ;
    rdfs:label "objectstore-data-transfer" ;
    core:usesTool :tool_objectstore_upload_file,
        :tool_objectstore_download_file,
        :tool_objectstore_upload_directory,
        :tool_objectstore_download_prefix,
        :tool_objectstore_bucket_exists,
        :tool_objectstore_list_objects .

:skill_objectstore_business_asset_store a core:Skill ;
    rdfs:label "objectstore-business-asset-store" ;
    core:usesTool :tool_objectstore_list_stores,
        :tool_objectstore_list_buckets,
        :tool_objectstore_create_bucket,
        :tool_objectstore_put_bucket_versioning,
        :tool_objectstore_get_bucket_versioning,
        :tool_objectstore_put_bucket_lifecycle,
        :tool_objectstore_get_bucket_lifecycle,
        :tool_objectstore_put_object,
        :tool_objectstore_upload_file,
        :tool_objectstore_put_object_tags,
        :tool_objectstore_get_object_tags,
        :tool_objectstore_head_object,
        :tool_objectstore_list_objects,
        :tool_objectstore_presigned_url,
        :tool_objectstore_ingest_objects .

:skill_objectstore_mcp_operations a core:Skill ;
    rdfs:label "objectstore-mcp-operations" ;
    core:usesTool :tool_objectstore_list_stores,
        :tool_objectstore_capabilities,
        :tool_objectstore_ingest_buckets,
        :tool_objectstore_ingest_objects .

:prompt_objectstore_asset_librarian a core:Prompt ;
    rdfs:label "objectstore_asset_librarian" .

:prompt_objectstore_operator a core:Prompt ;
    rdfs:label "objectstore-operator" .

:prompt_objectstore_storage_administrator a core:Prompt ;
    rdfs:label "objectstore-storage-administrator" .

:agent_objectstore_operator a core:Agent ;
    rdfs:label "Object store operator" ;
    rdfs:comment "Operator agent: routes requests to the asset-librarian or storage-administrator workflow." ;
    core:hasPrompt :prompt_objectstore_operator ;
    core:hasSkill :skill_objectstore_business_asset_store, :skill_objectstore_object_operations, :skill_objectstore_bucket_administration, :skill_objectstore_data_transfer, :skill_objectstore_mcp_operations .

:agent_objectstore_storage_administrator a core:Agent ;
    rdfs:label "Storage administrator" ;
    rdfs:comment "Business-role agent: provisions buckets, retention and versioning, moves bulk data and removes data with approval." ;
    core:hasPrompt :prompt_objectstore_storage_administrator ;
    core:hasSkill :skill_objectstore_bucket_administration, :skill_objectstore_data_transfer, :skill_objectstore_object_operations .

:agent_objectstore_asset_librarian a core:Agent ;
    rdfs:label "Asset Librarian" ;
    rdfs:comment "Business-role agent: keeps business media filed, tagged, retained and handed off from the object store." ;
    core:hasPrompt :prompt_objectstore_asset_librarian ;
    core:hasSkill :skill_objectstore_business_asset_store, :skill_objectstore_object_operations, :skill_objectstore_bucket_administration ;
    core:orchestrationUsesTool :tool_objectstore_list_stores,
        :tool_objectstore_list_buckets,
        :tool_objectstore_list_objects,
        :tool_objectstore_head_object,
        :tool_objectstore_put_object,
        :tool_objectstore_upload_file,
        :tool_objectstore_get_object_tags,
        :tool_objectstore_put_object_tags,
        :tool_objectstore_presigned_url,
        :tool_objectstore_get_bucket_lifecycle,
        :tool_objectstore_put_bucket_lifecycle,
        :tool_objectstore_get_bucket_versioning,
        :tool_objectstore_put_bucket_versioning,
        :tool_objectstore_ingest_objects .

:task_objectstore_provision_asset_buckets a core:Task ;
    rdfs:label "objectstore-provision-asset-buckets" ;
    rdfs:comment "Tool-use contract. Provision the business asset buckets with versioning and retention." ;
    core:hasStep :task_objectstore_provision_asset_buckets_step1, :task_objectstore_provision_asset_buckets_step2, :task_objectstore_provision_asset_buckets_step3, :task_objectstore_provision_asset_buckets_step4, :task_objectstore_provision_asset_buckets_step5 .

:task_objectstore_provision_asset_buckets_step1 a core:TaskStep ;
    rdfs:label "1. objectstore_list_buckets" ;
    core:usesTool :tool_objectstore_list_buckets ;
    core:needsSkill :skill_objectstore_business_asset_store ;
    core:precedes :task_objectstore_provision_asset_buckets_step2 .

:task_objectstore_provision_asset_buckets_step2 a core:TaskStep ;
    rdfs:label "2. objectstore_create_bucket" ;
    core:usesTool :tool_objectstore_create_bucket ;
    core:needsSkill :skill_objectstore_business_asset_store ;
    core:precedes :task_objectstore_provision_asset_buckets_step3 .

:task_objectstore_provision_asset_buckets_step3 a core:TaskStep ;
    rdfs:label "3. objectstore_put_bucket_versioning" ;
    core:usesTool :tool_objectstore_put_bucket_versioning ;
    core:needsSkill :skill_objectstore_business_asset_store ;
    core:precedes :task_objectstore_provision_asset_buckets_step4 .

:task_objectstore_provision_asset_buckets_step4 a core:TaskStep ;
    rdfs:label "4. objectstore_put_bucket_lifecycle" ;
    core:usesTool :tool_objectstore_put_bucket_lifecycle ;
    core:needsSkill :skill_objectstore_business_asset_store ;
    core:precedes :task_objectstore_provision_asset_buckets_step5 .

:task_objectstore_provision_asset_buckets_step5 a core:TaskStep ;
    rdfs:label "5. objectstore_get_bucket_lifecycle" ;
    core:usesTool :tool_objectstore_get_bucket_lifecycle ;
    core:needsSkill :skill_objectstore_business_asset_store .

:task_objectstore_file_asset a core:Task ;
    rdfs:label "objectstore-file-asset" ;
    rdfs:comment "Tool-use contract. File one business asset and tag its stage." ;
    core:hasStep :task_objectstore_file_asset_step1, :task_objectstore_file_asset_step2, :task_objectstore_file_asset_step3 .

:task_objectstore_file_asset_step1 a core:TaskStep ;
    rdfs:label "1. objectstore_put_object" ;
    core:usesTool :tool_objectstore_put_object ;
    core:needsSkill :skill_objectstore_business_asset_store ;
    core:precedes :task_objectstore_file_asset_step2 .

:task_objectstore_file_asset_step2 a core:TaskStep ;
    rdfs:label "2. objectstore_put_object_tags" ;
    core:usesTool :tool_objectstore_put_object_tags ;
    core:needsSkill :skill_objectstore_business_asset_store ;
    core:precedes :task_objectstore_file_asset_step3 .

:task_objectstore_file_asset_step3 a core:TaskStep ;
    rdfs:label "3. objectstore_head_object" ;
    core:usesTool :tool_objectstore_head_object ;
    core:needsSkill :skill_objectstore_business_asset_store .

:task_objectstore_hand_off_asset a core:Task ;
    rdfs:label "objectstore-hand-off-asset" ;
    rdfs:comment "Tool-use contract. Hand an asset to the review or publishing step by presigned URL, then record the new stage." ;
    core:hasStep :task_objectstore_hand_off_asset_step1, :task_objectstore_hand_off_asset_step2, :task_objectstore_hand_off_asset_step3, :task_objectstore_hand_off_asset_step4 .

:task_objectstore_hand_off_asset_step1 a core:TaskStep ;
    rdfs:label "1. objectstore_list_objects" ;
    core:usesTool :tool_objectstore_list_objects ;
    core:needsSkill :skill_objectstore_business_asset_store ;
    core:precedes :task_objectstore_hand_off_asset_step2 .

:task_objectstore_hand_off_asset_step2 a core:TaskStep ;
    rdfs:label "2. objectstore_get_object_tags" ;
    core:usesTool :tool_objectstore_get_object_tags ;
    core:needsSkill :skill_objectstore_business_asset_store ;
    core:precedes :task_objectstore_hand_off_asset_step3 .

:task_objectstore_hand_off_asset_step3 a core:TaskStep ;
    rdfs:label "3. objectstore_presigned_url" ;
    core:usesTool :tool_objectstore_presigned_url ;
    core:needsSkill :skill_objectstore_business_asset_store ;
    core:precedes :task_objectstore_hand_off_asset_step4 .

:task_objectstore_hand_off_asset_step4 a core:TaskStep ;
    rdfs:label "4. objectstore_put_object_tags" ;
    core:usesTool :tool_objectstore_put_object_tags ;
    core:needsSkill :skill_objectstore_business_asset_store .

:task_objectstore_delete_prefix a core:Task ;
    rdfs:label "objectstore-delete-prefix" ;
    rdfs:comment "Tool-use contract. Delete the objects under a prefix after a dry run." ;
    core:hasStep :task_objectstore_delete_prefix_step1, :task_objectstore_delete_prefix_step2, :task_objectstore_delete_prefix_step3 .

:task_objectstore_delete_prefix_step1 a core:TaskStep ;
    rdfs:label "1. objectstore_delete_objects_by_prefix" ;
    core:usesTool :tool_objectstore_delete_objects_by_prefix ;
    core:needsSkill :skill_objectstore_object_operations ;
    core:precedes :task_objectstore_delete_prefix_step2 .

:task_objectstore_delete_prefix_step2 a core:TaskStep ;
    rdfs:label "2. objectstore_delete_objects_by_prefix" ;
    core:usesTool :tool_objectstore_delete_objects_by_prefix ;
    core:needsSkill :skill_objectstore_object_operations ;
    core:precedes :task_objectstore_delete_prefix_step3 .

:task_objectstore_delete_prefix_step3 a core:TaskStep ;
    rdfs:label "3. objectstore_list_objects" ;
    core:usesTool :tool_objectstore_list_objects ;
    core:needsSkill :skill_objectstore_object_operations .

:task_objectstore_mirror_metadata a core:Task ;
    rdfs:label "objectstore-mirror-metadata" ;
    rdfs:comment "Tool-use contract. Mirror bucket and object metadata into the knowledge graph." ;
    core:hasStep :task_objectstore_mirror_metadata_step1, :task_objectstore_mirror_metadata_step2 .

:task_objectstore_mirror_metadata_step1 a core:TaskStep ;
    rdfs:label "1. objectstore_ingest_buckets" ;
    core:usesTool :tool_objectstore_ingest_buckets ;
    core:needsSkill :skill_objectstore_mcp_operations ;
    core:precedes :task_objectstore_mirror_metadata_step2 .

:task_objectstore_mirror_metadata_step2 a core:TaskStep ;
    rdfs:label "2. objectstore_ingest_objects" ;
    core:usesTool :tool_objectstore_ingest_objects ;
    core:needsSkill :skill_objectstore_mcp_operations .

:dataset_objectstore_objects a core:Dataset ;
    rdfs:label "objectstore-objects" ;
    rdfs:comment """Data location and routing: object bytes and metadata live in the backing store
    named by a tool call's store argument, resolved from OBJECTSTORE_STORES (default
    OBJECTSTORE_DEFAULT_STORE); the knowledge graph holds :ObjectStore/:Bucket/:Object
    metadata only, federated by live reads (objectstore_list_objects) and mirrored by
    objectstore_ingest_buckets / objectstore_ingest_objects. Bytes are never copied.""" ;
    core:storedIn :store_objectstore_default .

:store_objectstore_default a :ObjectStore ;
    rdfs:label "default object store (OBJECTSTORE_DEFAULT_STORE)" .
